def P12():
    n1 = int(input("Enter first integer: "))
    n2 = int(input("Enter second integer: "))
    nums = [n1,n2]
    CDlist = []
    for i in range(1,int(max(nums)/2)):
        if not (n1%i or n2%i):
            CDlist.append(i)
    GCD = max(CDlist)
    print(f"GCD is {GCD}")
    print(f"LCM is {int(n1*n2/GCD)}")
def P13():
    s = input("Enter a string: ")
    nv = nc = nu = nl = 0
    for ch in s:
        if ch.isalpha():
            if ch.upper() in ["A","E","I","O","U"]:
                nv += 1
            else:nc += 1
            if ch.isupper():
                nu += 1
            else:nl += 1
    info = {"vowels":nv,"consonents":nc,
            "uppercase letters":nu,"lowercase letters":nl}
    for k,v in info.items():
        print(f"Number of {k} in given string is {v}")
